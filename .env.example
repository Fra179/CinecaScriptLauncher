# Executable name on PATH or a full path, without command-line arguments.
CINECA_STEP_EXECUTABLE=step
# Use step-cli instead if that is the executable name on your system.
CINECA_EMAIL=your-email@example.com
CINECA_PASSWORD='replace-with-your-password'
CINECA_TOTP_SECRET='replace-with-your-base32-master-key'
CINECA_AUTH_TIMEOUT=120
